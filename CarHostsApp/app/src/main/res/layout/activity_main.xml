<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Car Hosts Manager"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Root Status -->
    <TextView
        android:id="@+id/txt_root_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Root Status: Checking..."
        android:textSize="14sp"
        android:textColor="#aaaaaa"
        android:layout_marginBottom="12dp"/>

    <!-- Input Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/edit_ip_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="IP Address"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:inputType="textUri"
            android:maxLines="1"/>

        <View
            android:layout_width="8dp"
            android:layout_height="0dp"/>

        <EditText
            android:id="@+id/edit_hostname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="Hostname (e.g., example.com)"
            android:textColor="#ffffff"
            android:textColorHint="#888888"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:inputType="textUri"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Button Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Entry"
            android:backgroundTint="#4CAF50"
            android:textColor="#ffffff"
            android:padding="12dp"/>

        <View
            android:layout_width="8dp"
            android:layout_height="0dp"/>

        <Button
            android:id="@+id/btn_apply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Apply to System"
            android:backgroundTint="#2196F3"
            android:textColor="#ffffff"
            android:padding="12dp"/>
    </LinearLayout>

    <!-- Button Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save Config"
            android:backgroundTint="#FF9800"
            android:textColor="#ffffff"
            android:padding="12dp"/>

        <View
            android:layout_width="8dp"
            android:layout_height="0dp"/>

        <Button
            android:id="@+id/btn_load"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Load Config"
            android:backgroundTint="#9C27B0"
            android:textColor="#ffffff"
            android:padding="12dp"/>

        <View
            android:layout_width="8dp"
            android:layout_height="0dp"/>

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear All"
            android:backgroundTint="#f44336"
            android:textColor="#ffffff"
            android:padding="12dp"/>
    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/txt_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textSize="14sp"
        android:textColor="#4CAF50"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Entries List Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Custom Entries (Long press to remove):"
        android:textSize="14sp"
        android:textColor="#cccccc"
        android:layout_marginBottom="8dp"/>

    <!-- Entries List -->
    <ListView
        android:id="@+id/list_view_entries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#2a2a3e"
        android:divider="#3a3a4e"
        android:dividerHeight="1dp"
        android:padding="4dp"/>

    <!-- Quick Presets Info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tip: Use code to add entries programmatically:\nhostsManager.addHostEntry(&quot;127.0.0.1&quot;, &quot;example.com&quot;);"
        android:textSize="12sp"
        android:textColor="#666666"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginTop="8dp"/>

</LinearLayout>
